{
  "name": "taskdoon",
  "version": "0.1.0",
  "private": true,
  "description": "Taskin — Persian-first enterprise communication & task management platform",
  "workspaces": [
    "packages/contracts",
    "packages/jalali",
    "packages/text",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build:packages": "tsc -b packages/contracts packages/jalali packages/text",
    "dev": "npm run build:packages && npm run dev -w @taskin/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('.husky/install.mjs')) await import('./.husky/install.mjs');\"",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @taskin/web",
    "test:e2e:live": "npm run test:e2e:live -w @taskin/web",
    "test:e2e:live:admin": "npm run test:e2e:live:admin -w @taskin/web",
    "test:e2e:live:password": "npm run test:e2e:live:password -w @taskin/web",
    "test:e2e:live:moderation": "npm run test:e2e:live:moderation -w @taskin/web",
    "test:e2e:live:workspace-moderation": "npm run test:e2e:live:workspace-moderation -w @taskin/web",
    "test:e2e:live:agile": "npm run test:e2e:live:agile -w @taskin/web",
    "check:contrast": "npm run check:contrast -w @taskin/web",
    "test:int": "npm run test:int -w @taskin/api",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait postgres pgbouncer redis-core redis-rt s3 s3-init mailpit",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:app": "docker compose --env-file .env.dev.local -f infra/docker-compose.yml --profile app up -d --build --wait",
    "test:broadcasts": "npm run test:broadcasts -w @taskin/web",
    "test:e2e:live:broadcasts": "npm run test:e2e:live:broadcasts -w @taskin/web",
    "test:e2e:live:admin-auth": "npm run test:e2e:live:admin-auth -w @taskin/web",
    "test:e2e:live:admin-roles": "npm run test:e2e:live:admin-roles -w @taskin/web",
    "test:e2e:site": "npm run test:e2e:site -w @taskin/web",
    "test:e2e:marketing-auth": "npm run test:e2e:marketing-auth -w @taskin/web",
    "test:e2e:auth-ui": "npm run test:e2e:auth-ui -w @taskin/web",
    "test:e2e:a11y": "npm run test:e2e:a11y -w @taskin/web"
  },
  "devDependencies": {
    "drizzle-orm": "0.45.4",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "vite": "8.3.3"
  }
}
