{
  "name": "taskin",
  "version": "0.1.0",
  "private": true,
  "description": "Taskin — Persian-first enterprise communication & task management platform",
  "workspaces": [
    "packages/contracts",
    "packages/jalali",
    "packages/text",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:packages": "tsc -b packages/contracts packages/jalali packages/text",
    "dev": "npm run build:packages && npm run dev -w @taskin/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @taskin/web",
    "test:e2e:live": "npm run test:e2e:live -w @taskin/web",
    "check:contrast": "npm run check:contrast -w @taskin/web",
    "test:int": "npm run test:int -w @taskin/api",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait postgres pgbouncer redis-core redis-rt s3 s3-init mailpit",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:app": "docker compose -f infra/docker-compose.yml --profile app up -d --build --wait"
  },
  "devDependencies": {
    "drizzle-orm": "0.45.3",
    "typescript": "5.7.2",
    "typescript-eslint": "8.70.1"
  }
}
