{
  "name": "@taskin/text",
  "version": "0.1.0",
  "private": true,
  "description": "Persian text helpers: digits, Iranian mobile numbers, monograms, note Markdown and checklists",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint src test",
    "test": "tsc -b && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@taskin/contracts": "0.1.0",
    "@taskin/jalali": "0.1.0"
  }
}
