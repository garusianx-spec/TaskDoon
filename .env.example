# Production-parity Compose variable reference. The local generator writes .env.prod.local
# and the certificates and service configs under .local/prod. See docs/devops/containerization.md.
# Keep credentials in the ignored env file or your deployment secret store.

HTTPS_PORT=8443
PUBLIC_WEB_ORIGIN=https://localhost:8443
S3_PUBLIC_ENDPOINT=https://localhost:8443
SMS_PROVIDERS=console
SMTP_URL=smtp://mailpit:1025

POSTGRES_PASSWORD=
TASKIN_APP_PASSWORD=
TASKIN_MIGRATOR_PASSWORD=
TASKIN_PLATFORM_ADMIN_PASSWORD=
REDIS_CORE_PASSWORD=
REDIS_RT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Empty placeholders. Generate local credentials with node infra/init-dev-env.mjs.
# Set these values through the deployment secret store in production.
JWT_PRIVATE_JWKS=
OTP_PEPPER=
APP_ENCRYPTION_KEY=
KAVENEGAR_API_KEY=

# For Next.js development, see apps/web/.env.example.
NEXT_PUBLIC_GA_ID=G-YYNSPSFVCJ
