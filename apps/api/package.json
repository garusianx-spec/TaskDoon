{
  "name": "@taskin/api",
  "version": "0.1.0",
  "private": true,
  "description": "Taskin API: NestJS modular monolith (http, ws and worker roles)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run --config vitest.config.ts",
    "test:int": "tsc -b && vitest run --config vitest.integration.config.ts",
    "dev": "node scripts/dev.mjs",
    "start": "node --enable-source-maps --import ./dist/instrument.js dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsc -b && node --enable-source-maps dist/cli/migrate.js",
    "db:snapshot": "tsc -b && node --enable-source-maps dist/cli/schema-snapshot.js --write",
    "perf:seed": "tsc -b && node --enable-source-maps dist/cli/perf.js --seed",
    "perf:measure": "tsc -b && node --enable-source-maps dist/cli/perf.js --measure",
    "openapi": "tsc -b && node --enable-source-maps dist/cli/openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-presigned-post": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@casl/ability": "7.0.1",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/platform-socket.io": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@taskin/contracts": "0.1.0",
    "@taskin/jalali": "0.1.0",
    "@taskin/text": "0.1.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.3",
    "fractional-indexing": "^4.0.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.14",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.2.1",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "socket.io-client": "4.8.3",
    "supertest": "7.3.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
