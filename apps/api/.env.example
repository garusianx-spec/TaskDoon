# Local development against `npm run infra:up` (see infra/docker-compose.yml).
# Copy to .env and `set -a; . ./.env; set +a` before `npm run dev -w @taskin/api`.
# Every variable is validated at start-up (src/config/env.ts); production refuses the
# development shortcuts marked below.

NODE_ENV=development
# http | ws | worker | all  (all = everything in one process, for local work)
APP_ROLE=all
PORT=4000
LOG_LEVEL=info
LOG_PRETTY=true

# As taskin_app through PgBouncer (transaction pooling); direct for LISTEN and advisory locks.
DATABASE_URL=postgres://taskin_app:taskin_app@localhost:6432/taskin
DATABASE_DIRECT_URL=postgres://taskin_app:taskin_app@localhost:5432/taskin
# As taskin_migrator, the schema owner: only `npm run db:migrate` uses it.
DATABASE_MIGRATOR_URL=postgres://taskin_migrator:taskin_migrator@localhost:5432/taskin

REDIS_CORE_URL=redis://localhost:6379
REDIS_RT_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:8333
S3_BUCKET=taskin-files
S3_ACCESS_KEY=taskin
S3_SECRET_KEY=taskin-dev-secret

SMTP_URL=smtp://localhost:1025
PUBLIC_WEB_ORIGIN=http://localhost:3000
# Plain-http development only; production requires true.
COOKIE_SECURE=false

# Development values. Production: long random secrets from the secret store.
OTP_PEPPER=development-only-pepper-change-me-please
# 32 bytes, base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS1rZXktY2hhbmdlLW1lISE=
# A JSON array of private Ed25519 JWKs with a kid; the first signs. Unset outside production
# means an ephemeral key per process.
# JWT_PRIVATE_JWKS=[{"kty":"OKP","crv":"Ed25519","kid":"2026-09","d":"…","x":"…"}]

# Realtime (ws role): the Socket.IO adapter on redis-rt, redis or redis-sharded (Redis 7+ sharded
# Pub/Sub, for a Redis Cluster); the per-socket message:send limit; this node's presence name.
# RT_ADAPTER=redis
# WS_SEND_BURST=20
# WS_SEND_PER_SECOND=5
# WS_NODE_ID=ws-1

# REST limits per minute: per client IP (behind a proxy, set TRUST_PROXY) and per signed-in user.
# THROTTLE_IP_PER_MINUTE=300
# THROTTLE_USER_PER_MINUTE=600

# console logs codes instead of sending them (refused in production).
SMS_PROVIDERS=console
# SMS_PROVIDERS=kavenegar,smsir
# KAVENEGAR_API_KEY=
# SMSIR_API_KEY=
# SMSIR_OTP_TEMPLATE_ID=
# SMSIR_INVITE_TEMPLATE_ID=
# SMSIR_ALERT_TEMPLATE_ID=

# Traces go to the collector when set (loaded by dist/instrument.js).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
