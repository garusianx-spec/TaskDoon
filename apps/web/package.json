{
  "name": "@taskin/web",
  "version": "0.1.0",
  "private": true,
  "description": "Taskin web app — Next.js, RTL, Jalali",
  "scripts": {
    "build:deps": "tsc -b ../../packages/contracts ../../packages/jalali ../../packages/text",
    "predev": "npm run build:deps",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "prebuild": "npm run build:deps",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint src",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:live": "node e2e/live/flow.mjs",
    "test:e2e:live:admin": "node e2e/live/admin.mjs",
    "test:e2e:live:password": "node e2e/live/password.mjs",
    "test:e2e:live:moderation": "node e2e/live/moderation.mjs",
    "test:e2e:live:workspace-moderation": "node e2e/live/workspace-moderation.mjs",
    "test:e2e:live:agile": "node e2e/live/agile.mjs",
    "pretest": "npm run build:deps",
    "test": "vitest run",
    "pretest:watch": "npm run build:deps",
    "test:watch": "vitest",
    "test:broadcasts": "node --test e2e/unit/broadcasts.test.mjs",
    "test:e2e:live:broadcasts": "node e2e/live/broadcasts.mjs",
    "test:e2e:live:admin-auth": "node e2e/live/admin-conditional-auth.mjs",
    "test:e2e:live:admin-roles": "node e2e/live/admin-role-management.mjs",
    "test:e2e:site": "node e2e/live/site.mjs",
    "test:e2e:marketing-auth": "node e2e/live/marketing-auth.mjs",
    "test:e2e:auth-ui": "node e2e/auth/states.mjs",
    "test:e2e:a11y": "node e2e/auth/accessibility.mjs"
  },
  "dependencies": {
    "@taskin/contracts": "0.1.0",
    "@taskin/jalali": "0.1.0",
    "@taskin/text": "0.1.0",
    "clsx": "2.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.3",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.17.0",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.63.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.2",
    "vitest": "5.0.2"
  }
}
