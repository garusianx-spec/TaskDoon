# Copy to apps/web/.env.local. All three are read at build time (`next dev` / `next build`).

# `api` (default): the live app against the Taskin API. `demo`: the in-memory fixture workspace
# the Playwright suites in e2e/suites drive.
NEXT_PUBLIC_DATA_SOURCE=api

# Where /api/v1 and the Socket.IO path /rt/ are proxied. Rewrites are compiled into the build.
TASKIN_API_ORIGIN=http://localhost:4000

# Optional: connect the socket to another origin (an edge that routes /rt itself).
# NEXT_PUBLIC_RT_URL=
