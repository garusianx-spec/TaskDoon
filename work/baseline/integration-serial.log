+ {
+   "openapi": "3.0.0",
+   "paths": {
+     "/api/v1/auth/otp/request": {
+       "post": {
+         "operationId": "Auth_request",
+         "parameters": [],
+         "requestBody": {
+           "required": true,
+           "content": {
+             "application/json": {
+               "schema": {
+                 "$ref": "#/components/schemas/OtpRequestDto"
+               }
+             }
+           }
+         },
+         "responses": {
+           "200": {
+             "description": "",
+             "content": {
+               "application/json": {
+                 "schema": {
+                   "$ref": "#/components/schemas/OtpChallengeDto"
+                 }
+               }
+             }
+           }
+         },
+         "summary": "Text a sign-in code to a mobile number (same answer whether or not it has an account)",
+         "tags": [
+           "auth"
+         ]
+       }
+     },
+     "/api/v1/auth/otp/verify": {
+       "post": {
+         "operationId": "Auth_verify",
+         "parameters": [],
+         "requestBody": {
+           "required": true,
+           "content": {
+             "application/json": {
+               "schema": {
+                 "$ref": "#/components/schemas/OtpVerifyDto"
+               }
+             }
+           }
+         },
+         "responses": {
+           "200": {
+             "description": "",
+             "content": {
+               "application/json": {
+                 "schema": {
+                   "oneOf": [
+                     {
+                       "type": "object",
+                       "properties": {
+                         "status": {
+                           "type": "string",
+                           "enum": [
+                             "signed_in"
+                           ]
+                         },
+                         "session": {
+                           "$ref": "#/components/schemas/AuthSessionDto"
+                         }
+                       }
+                     },
+                     {
+                       "type": "object",
+                       "properties": {
+                         "status": {
+                           "type": "string",
+                           "enum": [
+                             "signup_required"
+                           ]
+                         },
+                         "signupToken": {
+                           "type": "string"
+                         },
+                         "expiresInSeconds": {
+                           "type": "integer"
+                         }
+                       }
+                     }
+                   ]
+                 }
+               }
+             }
+           }
+         },
+         "summary": "Check the code: signs in, or returns a sign-up token for a new number",
+         "tags": [
+           "auth"
+         ]
+       }
+     },
+     "/api/v1/auth/password/login": {
+       "post": {
+         "operationId": "Auth_passwordLogin",
+         "parameters": [],
+         "requestBody": {
+           "required": true,
+           "content": {
+             "application/json": {
+               "schema": {
+                 "$ref": "#/components/schemas/PasswordSignInDto"
+               }
+             }
+           }
+         },
+         "responses": {
+           "200": {
+             "description": "",
+             "content": {
+               "application/json": {
+                 "schema": {
+                   "$ref": "#/components/schemas/AuthSessionDto"
+                 }
+               }
+             }
+           }
+         },
+         "summary": "Sign in with phone and password (for accounts that set one); the SMS code stays the default",
+         "tags": [
+           "auth"
+         ]
+       }
+     },
+     "/api/v1/auth/password/forgot": {
+       "post": {
+         "operationId": "Auth_forgotPassword",
+         "parameters": [],
+         "requestBody": {
+           "required": true,
+           "content": {
+             "application/json": {
+               "schema": {
+                 "$ref": "#/components/schemas/PasswordForgotDto"
+               }
+             }
+           }
+         },
+         "responses": {
+           "200": {
+             "description": "",
+             "content": {
+               "application/json": {
+                 "schema": {
+                   "$ref": "#/components/schemas/OtpChallengeDto"
+                 }
+               }
+             }
+           }
+         },
+         "summary": "Text a password reset code to the number (same answer whether or not it has an account)",
+         "tags": [
+           "auth"
+         ]
+       }
+     },
+     "/api/v1/auth/password/recover": {
+       "post": {
+         "operationId": "Auth_recoverPassword",
+         "parameters": [],
+         "requestBody": {
+           "required": true,
+           "content": {
+             "application/json": {
+               "schema": {
+                 "$ref": "#/components/schemas/PasswordRecoverDto"
+               }
+             }
+           }
+         },
+         "responses": {
+           "204": {
+             "description": ""
+           }
+         },
+         "summary": "Set a new password with the reset code from the SMS (signs every session out)",
+         "tags": [
+           "auth"
+         ]
+       }
+     },
+     "/api/v1/auth/signup": {
+       "post": {
+         "operationId": "Auth_signup",
+         "parameters": [],
+         "requestBody": {
+           "required": true,
+           "content": {
+             "application/json": {
+               "schema": {
+                 "$ref": "#/components/schemas/SignupDto"
+               }
+             }
+           }
+         },
+         "responses": {
+           "200": {
+             "description": "",
+             "content": {
+               "application/json": {
+                 "schema": {
+                   "$ref": "#/components/schemas/AuthSessionDto"
+                 }
+               }
+             }
+           }
+         },
+         "summary": "Create the account for a verified number and sign in",
+         "tags": [
+           "auth"
+         ]
+       }
+     },
+     "/api/v1/auth/refresh": {
+       "post": {
+         "operationId": "Auth_refresh",
+         "parameters": [
+           {
+             "name": "X-CSRF-Token",
+             "in": "header",
+             "description": "The value of the readable CSRF cookie",
+             "required": true,
+             "schema": {
+               "type": "string"
+             }
+           }
+         ],
+         "responses": {
+           "200": {
+             "description": "",
+             "content": {
+               "application/json": {
+                 "schema": {
+                   "$ref": "#/components/schemas/AuthSessionDto"
+                 }
+               }
+             }
+           }
+         },
+         "summary": "Rotate the refresh cookie and get a new access token",
+         "tags": [
+           "auth"
+         ]
+       }
+     },
+     "/api/v1/auth/logout": {
+       "post": {
+         "operationId": "Auth_logout",
+         "parameters": [
+           {
+             "name": "X-CSRF-Token",
+             "in": "header",
+             "description": "The value of the readable CSRF cookie",
+             "required": true,
+             "schema": {
+               "type": "string"
+             }
+           }
+         ],
+         "responses": {
+           "204": {
+             "description": ""
+           }
+         },
+         "summary": "Sign this device out",
+         "tags": [
+           "auth"
+         ]
+       }
+     },
+     "/api/v1/auth/step-up": {
+       "post": {
+         "operationId": "Auth_stepUp",
+         "parameters": [],
+         "requestBody": {
+           "required": true,
+           "content": {
+             "application/json": {
+               "schema": {
+                 "$ref": "#/components/schemas/StepUpDto"
+               }
+             }
+           }
+         },
+         "responses": {
+           "200": {
+             "description": "",
+             "content": {
+               "application/json": {
+                 "schema": {
+                   "$ref": "#/components/schemas/AuthSessionDto"
+                 }
+               }
+             }
+           }
+         },
+         "security": [
+           {
+             "bearer": []
+           }
+         ],
+         "summary": "Re-verify the admin password; the returned token allows sensitive actions for 15 minutes",
+         "tags": [
+           "auth"
+         ]
+       }
+     },
+     "/api/v1/auth/otp/confirm/request": {
+       "post": {
+         "operationId": "Auth_requestConfirmation",
+         "parameters": [],
+         "responses": {
+           "200": {
+             "description": "",
+             "content": {
+               "application/json": {
+                 "schema": {
+                   "$ref": "#/components/schemas/OtpChallengeDto"
+                 }
+               }
+             }
+           }
+         },
+         "security": [
+           {
+             "bearer": []
